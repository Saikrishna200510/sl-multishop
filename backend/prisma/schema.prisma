datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// ENUMS
// ----------------------------------------------------

enum ShopStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
  INACTIVE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
  SUSPENDED
}

enum PaymentStatus {
  PENDING
  VERIFIED
  REJECTED
  SUCCESS
  FAILED
}

enum StockMovementType {
  PURCHASE
  SALE
  RETURN_IN
  RETURN_OUT
  ADJUSTMENT_UP
  ADJUSTMENT_DOWN
  TRANSFER_IN
  TRANSFER_OUT
}

enum TransferStatus {
  PENDING
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

enum POStatus {
  DRAFT
  ORDERED
  PARTIAL_RECEIVED
  COMPLETED
  CANCELLED
}

enum LedgerType {
  INVOICE
  PAYMENT
  RETURN
  ADJUSTMENT
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  PARTIALLY_PAID
  CANCELLED
  REFUNDED
}

enum InvoicePaymentStatus {
  UNPAID
  PARTIAL
  COMPLETED
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  SPLIT
  CREDIT
  WALLET
  BANK_TRANSFER
}

enum ReturnStatus {
  PENDING
  COMPLETED
  REJECTED
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum CashTxType {
  CASH_SALE
  CASH_RETURN
  CASH_IN
  CASH_OUT
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

// ----------------------------------------------------
// MODELS
// ----------------------------------------------------

model Shop {
  id            String     @id @default(uuid()) @db.Uuid
  name          String     @db.VarChar(255)
  slug          String     @unique @db.VarChar(100)
  business_type String     @default("GENERAL_RETAIL") @db.VarChar(50)
  logo_url      String?
  email         String?    @db.VarChar(255)
  phone         String?    @db.VarChar(50)
  gstin         String?    @db.VarChar(20)
  currency      String     @default("INR") @db.VarChar(10)
  timezone      String     @default("Asia/Kolkata") @db.VarChar(50)
  status        ShopStatus @default(ACTIVE)
  created_at    DateTime   @default(now()) @db.Timestamptz(6)
  updated_at    DateTime   @updatedAt @db.Timestamptz(6)

  // Relationships
  branches              Branch[]
  counters              Counter[]
  user_roles            UserRole[]
  roles                 Role[]
  subscriptions         Subscription[]
  subscription_payments SubscriptionPayment[]
  categories            Category[]
  brands                Brand[]
  units                 Unit[]
  products              Product[]
  product_variants      ProductVariant[]
  product_barcodes      ProductBarcode[]
  stock_balances        StockBalance[]
  stock_movements       StockMovement[]
  stock_transfers       StockTransfer[]
  suppliers             Supplier[]
  purchase_orders       PurchaseOrder[]
  purchase_items        PurchaseItem[]
  goods_receipts        GoodsReceipt[]
  customers             Customer[]
  customer_addresses    CustomerAddress[]
  customer_ledger       CustomerLedger[]
  invoices              Invoice[]
  invoice_items         InvoiceItem[]
  invoice_taxes         InvoiceTax[]
  payments              Payment[]
  payment_allocations   PaymentAllocation[]
  sales_returns         SalesReturn[]
  sales_return_items    SalesReturnItem[]
  credit_notes          CreditNote[]
  expenses              Expense[]
  expense_categories    ExpenseCategory[]
  cash_sessions         CashSession[]
  cash_transactions     CashTransaction[]
  shop_settings         ShopSettings?
  invoice_templates     InvoiceTemplate[]
  tax_rates             TaxRate[]
  audit_logs            AuditLog[]
  notifications         Notification[]
  support_tickets       SupportTicket[]
  idempotency_keys      IdempotencyKey[]

  @@index([status])
  @@index([slug])
  @@map("shops")
}

model Branch {
  id             String   @id @default(uuid()) @db.Uuid
  shop_id        String   @db.Uuid
  name           String   @db.VarChar(255)
  code           String   @db.VarChar(50)
  phone          String?  @db.VarChar(50)
  email          String?  @db.VarChar(255)
  address_line1  String?
  address_line2  String?
  city           String?  @db.VarChar(100)
  state          String?  @db.VarChar(100)
  postal_code    String?  @db.VarChar(20)
  is_main        Boolean  @default(false)
  status         String   @default("ACTIVE") @db.VarChar(20)
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @updatedAt @db.Timestamptz(6)

  shop            Shop            @relation(fields: [shop_id], references: [id], onDelete: Cascade)
  counters        Counter[]
  user_roles      UserRole[]
  stock_balances  StockBalance[]
  stock_movements StockMovement[]
  src_transfers   StockTransfer[] @relation("TransferSource")
  dest_transfers  StockTransfer[] @relation("TransferDestination")
  purchase_orders PurchaseOrder[]
  invoices        Invoice[]
  payments        Payment[]
  sales_returns   SalesReturn[]
  expenses        Expense[]
  cash_sessions   CashSession[]

  @@unique([shop_id, code])
  @@index([shop_id])
  @@map("branches")
}

model Counter {
  id         String   @id @default(uuid()) @db.Uuid
  shop_id    String   @db.Uuid
  branch_id  String   @db.Uuid
  name       String   @db.VarChar(100)
  code       String   @db.VarChar(50)
  device_id  String?  @db.VarChar(100)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  shop          Shop          @relation(fields: [shop_id], references: [id], onDelete: Cascade)
  branch        Branch        @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  invoices      Invoice[]
  cash_sessions CashSession[]

  @@unique([branch_id, code])
  @@index([shop_id])
  @@index([branch_id])
  @@map("counters")
}

model User {
  id             String     @id @default(uuid()) @db.Uuid
  email          String     @unique @db.VarChar(255)
  password_hash  String
  first_name     String     @db.VarChar(100)
  last_name      String     @db.VarChar(100)
  phone          String?    @db.VarChar(50)
  is_super_admin Boolean    @default(false)
  status         UserStatus @default(ACTIVE)
  created_at     DateTime   @default(now()) @db.Timestamptz(6)
  updated_at     DateTime   @updatedAt @db.Timestamptz(6)

  user_roles      UserRole[]
  refresh_tokens  RefreshToken[]
  audit_logs      AuditLog[]
  notifications   Notification[]
  support_tickets SupportTicket[]

  @@index([email])
  @@index([is_super_admin])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  shop_id     String?  @db.Uuid
  name        String   @db.VarChar(100)
  description String?
  is_system   Boolean  @default(false)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @updatedAt @db.Timestamptz(6)

  shop             Shop?            @relation(fields: [shop_id], references: [id], onDelete: Cascade)
  user_roles       UserRole[]
  role_permissions RolePermission[]

  @@unique([shop_id, name])
  @@index([shop_id])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(100)
  module      String   @db.VarChar(50)
  description String?
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  role_permissions RolePermission[]

  @@index([module])
  @@map("permissions")
}

model UserRole {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid
  role_id    String   @db.Uuid
  shop_id    String?  @db.Uuid
  branch_id  String?  @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)

  user   User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role   Role    @relation(fields: [role_id], references: [id], onDelete: Cascade)
  shop   Shop?   @relation(fields: [shop_id], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branch_id], references: [id], onDelete: SetNull)

  @@unique([user_id, role_id, shop_id])
  @@index([user_id])
  @@index([shop_id])
  @@map("user_roles")
}

model RolePermission {
  id            String   @id @default(uuid()) @db.Uuid
  role_id       String   @db.Uuid
  permission_id String   @db.Uuid
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  role       Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@unique([role_id, permission_id])
  @@index([role_id])
  @@map("role_permissions")
}

model RefreshToken {
  id          String    @id @default(uuid()) @db.Uuid
  user_id     String    @db.Uuid
  token_hash  String    @unique
  device_info String?
  ip_address  String?   @db.VarChar(50)
  expires_at  DateTime  @db.Timestamptz(6)
  revoked_at  DateTime? @db.Timestamptz(6)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([token_hash])
  @@map("refresh_tokens")
}

model Plan {
  id                     String   @id @default(uuid()) @db.Uuid
  name                   String   @unique @db.VarChar(100)
  slug                   String   @unique @db.VarChar(100)
  description            String?
  monthly_price          Decimal  @db.Decimal(10, 2)
  annual_price           Decimal  @db.Decimal(10, 2)
  max_branches           Int      @default(1)
  max_counters           Int      @default(1)
  max_users              Int      @default(3)
  max_products           Int      @default(1000)
  max_invoices_per_month Int      @default(1000)
  features               Json?
  is_active              Boolean  @default(true)
  created_at             DateTime @default(now()) @db.Timestamptz(6)
  updated_at             DateTime @updatedAt @db.Timestamptz(6)

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id               String             @id @default(uuid()) @db.Uuid
  shop_id          String             @db.Uuid
  plan_id          String             @db.Uuid
  billing_cycle    BillingCycle       @default(MONTHLY)
  status           SubscriptionStatus @default(TRIAL)
  start_date       DateTime           @db.Timestamptz(6)
  end_date         DateTime           @db.Timestamptz(6)
  grace_period_end DateTime?          @db.Timestamptz(6)
  auto_renew       Boolean            @default(true)
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  updated_at       DateTime           @updatedAt @db.Timestamptz(6)

  shop     Shop                  @relation(fields: [shop_id], references: [id], onDelete: Cascade)
  plan     Plan                  @relation(fields: [plan_id], references: [id], onDelete: Restrict)
  payments SubscriptionPayment[]

  @@index([shop_id])
  @@index([status])
  @@map("subscriptions")
}

model SubscriptionPayment {
  id                    String        @id @default(uuid()) @db.Uuid
  subscription_id       String        @db.Uuid
  shop_id               String        @db.Uuid
  amount                Decimal       @db.Decimal(10, 2)
  payment_method        String        @default("UPI") @db.VarChar(50)
  transaction_reference String?       @db.VarChar(100)
  status                PaymentStatus @default(PENDING)
  verified_by           String?       @db.Uuid
  verified_at           DateTime?     @db.Timestamptz(6)
  notes                 String?
  created_at            DateTime      @default(now()) @db.Timestamptz(6)
  updated_at            DateTime      @updatedAt @db.Timestamptz(6)

  subscription Subscription @relation(fields: [subscription_id], references: [id], onDelete: Cascade)
  shop         Shop         @relation(fields: [shop_id], references: [id], onDelete: Cascade)

  @@index([shop_id])
  @@index([subscription_id])
  @@index([status])
  @@map("subscription_payments")
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  shop_id     String   @db.Uuid
  parent_id   String?  @db.Uuid
  name        String   @db.VarChar(100)
  slug        String   @db.VarChar(100)
  description String?
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @updatedAt @db.Timestamptz(6)

  shop     Shop       @relation(fields: [shop_id], references: [id], onDelete: Cascade)
  parent   Category?  @relation("CategoryHierarchy", fields: [parent_id], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@unique([shop_id, slug])
  @@index([shop_id])
  @@map("categories")
}

model Brand {
  id          String   @id @default(uuid()) @db.Uuid
  shop_id     String   @db.Uuid
  name        String   @db.VarChar(100)
  description String?
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @updatedAt @db.Timestamptz(6)

  shop     Shop      @relation(fields: [shop_id], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([shop_id, name])
  @@index([shop_id])
  @@map("brands")
}

model Unit {
  id         String   @id @default(uuid()) @db.Uuid
  shop_id    String?  @db.Uuid
  name       String   @db.VarChar(50)
  code       String   @db.VarChar(20)
  precision  Int      @default(0)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  shop     Shop?     @relation(fields: [shop_id], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([shop_id, code])
  @@index([shop_id])
  @@map("units")
}

model Product {
  id                 String   @id @default(uuid()) @db.Uuid
  shop_id            String   @db.Uuid
  category_id        String?  @db.Uuid
  brand_id           String?  @db.Uuid
  unit_id            String   @db.Uuid
  name               String   @db.VarChar(255)
  sku                String   @db.VarChar(100)
  barcode            String?  @db.VarChar(100)
  hsn_code           String?  @db.VarChar(50)
  description        String?
  is_variant_product Boolean  @default(false)
  tax_rate           Decimal  @default(0.00) @db.Decimal(5, 2)
  purchase_price     Decimal  @db.Decimal(12, 2)
  selling_price      Decimal  @db.Decimal(12, 2)
  mrp                Decimal? @db.Decimal(12, 2)
  min_stock_level    Decimal  @default(0) @db.Decimal(12, 3)
  is_batch_tracked   Boolean  @default(false)
  is_expiry_tracked  Boolean  @default(false)
  is_serial_tracked  Boolean  @default(false)
  is_weight_based    Boolean  @default(false)
  metadata           Json?
  is_active          Boolean  @default(true)
  created_at         DateTime @default(now()) @db.Timestamptz(6)
  updated_at         DateTime @updatedAt @db.Timestamptz(6)

  shop             Shop              @relation(fields: [shop_id], references: [id], onDelete: Cascade)
  category         Category?         @relation(fields: [category_id], references: [id], onDelete: SetNull)
  brand            Brand?            @relation(fields: [brand_id], references: [id], onDelete: SetNull)
  unit             Unit              @relation(fields: [unit_id], references: [id], onDelete: Restrict)
  variants         ProductVariant[]
  barcodes         ProductBarcode[]
  stock_balances   StockBalance[]
  stock_movements  StockMovement[]
  purchase_items   PurchaseItem[]
  invoice_items    InvoiceItem[]
  sales_return_items SalesReturnItem[]

  @@unique([shop_id, sku])
  @@index([shop_id])
  @@index([shop_id, barcode])
  @@index([shop_id, name])
  @@map("products")
}

model ProductVariant {
  id             String   @id @default(uuid()) @db.Uuid
  shop_id        String   @db.Uuid
  product_id     String   @db.Uuid
  name           String   @db.VarChar(150)
  sku            String   @db.VarChar(100)
  barcode        String?  @db.VarChar(100)
  attributes     Json
  purchase_price Decimal  @db.Decimal(12, 2)
  selling_price  Decimal  @db.Decimal(12, 2)
  mrp            Decimal? @db.Decimal(12, 2)
  is_active      Boolean  @default(true)
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @updatedAt @db.Timestamptz(6)

  shop            Shop             @relation(fields: [shop_id], references: [id], onDelete: Cascade)
  product         Product          @relation(fields: [product_id], references: [id], onDelete: Cascade)
  barcodes        ProductBarcode[]
  stock_balances  StockBalance[]
  stock_movements StockMovement[]
  purchase_items  PurchaseItem[]
  invoice_items   InvoiceItem[]

  @@unique([shop_id, sku])
  @@index([shop_id])
  @@index([product_id])
  @@map("product_variants")
}

model ProductBarcode {
  id           String   @id @default(uuid()) @db.Uuid
  shop_id      String   @db.Uuid
  product_id   String   @db.Uuid
  variant_id   String?  @db.Uuid
  barcode      String   @db.VarChar(100)
  barcode_type String   @default("EAN13") @db.VarChar(30)
  is_primary   Boolean  @default(true)
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  shop    Shop            @relation(fields: [shop_id], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [product_id], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variant_id], references: [id], onDelete: Cascade)

  @@unique([shop_id, barcode])
  @@index([shop_id])
  @@index([barcode])
  @@map("product_barcodes")
}

model StockBalance {
  id                 String    @id @default(uuid()) @db.Uuid
  shop_id            String    @db.Uuid
  branch_id          String    @db.Uuid
  product_id         String    @db.Uuid
  variant_id         String?   @db.Uuid
  batch_number       String?   @db.VarChar(100)
  expiry_date        DateTime? @db.Date
  quantity           Decimal   @default(0) @db.Decimal(12, 3)
  available_quantity Decimal   @default(0) @db.Decimal(12, 3)
  reserved_quantity  Decimal   @default(0) @db.Decimal(12, 3)
  cost_price         Decimal   @default(0) @db.Decimal(12, 2)
  updated_at         DateTime  @updatedAt @db.Timestamptz(6)

  shop    Shop            @relation(fields: [shop_id], references: [id], onDelete: Cascade)
  branch  Branch          @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [product_id], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variant_id], references: [id], onDelete: Cascade)

  @@unique([branch_id, product_id, variant_id, batch_number])
  @@index([shop_id])
  @@index([branch_id])
  @@index([product_id])
  @@map("stock_balances")
}

model StockMovement {
  id             String            @id @default(uuid()) @db.Uuid
  shop_id        String            @db.Uuid
  branch_id      String            @db.Uuid
  product_id     String            @db.Uuid
  variant_id     String?           @db.Uuid
  batch_number   String?           @db.VarChar(100)
  movement_type  StockMovementType
  quantity       Decimal           @db.Decimal(12, 3)
  previous_stock Decimal           @db.Decimal(12, 3)
  new_stock      Decimal           @db.Decimal(12, 3)
  unit_cost      Decimal           @db.Decimal(12, 2)
  reference_id   String?           @db.VarChar(100)
  reference_type String?           @db.VarChar(50)
  notes          String?
  created_by     String?           @db.Uuid
  created_at     DateTime          @default(now()) @db.Timestamptz(6)

  shop    Shop            @relation(fields: [shop_id], references: [id], onDelete: Cascade)
  branch  Branch          @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [product_id], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variant_id], references: [id], onDelete: Cascade)

  @@index([shop_id])
  @@index([branch_id])
  @@index([product_id])
  @@index([created_at])
  @@map("stock_movements")
}

model StockTransfer {
  id                    String         @id @default(uuid()) @db.Uuid
  shop_id               String         @db.Uuid
  transfer_number       String         @db.VarChar(100)
  source_branch_id      String         @db.Uuid
  destination_branch_id String         @db.Uuid
  status                TransferStatus @default(PENDING)
  items                 Json
  notes                 String?
  sent_by               String?        @db.Uuid
  received_by           String?        @db.Uuid
  sent_at               DateTime?      @db.Timestamptz(6)
  received_at           DateTime?      @db.Timestamptz(6)
  created_at            DateTime       @default(now()) @db.Timestamptz(6)
  updated_at            DateTime       @updatedAt @db.Timestamptz(6)

  shop               Shop   @relation(fields: [shop_id], references: [id], onDelete: Cascade)
  source_branch      Branch @relation("TransferSource", fields: [source_branch_id], references: [id], onDelete: Restrict)
  destination_branch Branch @relation("TransferDestination", fields: [destination_branch_id], references: [id], onDelete: Restrict)

  @@unique([shop_id, transfer_number])
  @@index([shop_id])
  @@map("stock_transfers")
}

model Supplier {
  id              String   @id @default(uuid()) @db.Uuid
  shop_id         String   @db.Uuid
  name            String   @db.VarChar(255)
  company_name    String?  @db.VarChar(255)
  email           String?  @db.VarChar(255)
  phone           String?  @db.VarChar(50)
  gstin           String?  @db.VarChar(20)
  address         String?
  city            String?  @db.VarChar(100)
  state           String?  @db.VarChar(100)
  current_balance Decimal  @default(0) @db.Decimal(12, 2)
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @updatedAt @db.Timestamptz(6)

  shop            Shop            @relation(fields: [shop_id], references: [id], onDelete: Cascade)
  purchase_orders PurchaseOrder[]

  @@unique([shop_id, name])
  @@index([shop_id])
  @@map("suppliers")
}

model PurchaseOrder {
  id              String    @id @default(uuid()) @db.Uuid
  shop_id         String    @db.Uuid
  branch_id       String    @db.Uuid
  supplier_id     String    @db.Uuid
  po_number       String    @db.VarChar(100)
  order_date      DateTime  @default(now()) @db.Date
  expected_date   DateTime? @db.Date
  subtotal        Decimal   @db.Decimal(12, 2)
  tax_amount      Decimal   @default(0) @db.Decimal(12, 2)
  total_amount    Decimal   @db.Decimal(12, 2)
  paid_amount     Decimal   @default(0) @db.Decimal(12, 2)
  status          POStatus  @default(DRAFT)
  notes           String?
  created_by      String?   @db.Uuid
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @updatedAt @db.Timestamptz(6)

  shop           Shop           @relation(fields: [shop_id], references: [id], onDelete: Cascade)
  branch         Branch         @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  supplier       Supplier       @relation(fields: [supplier_id], references: [id], onDelete: Restrict)
